// 双掌 (SO-SHO) キーマップ — Cygnus のキーマップに合わせた構成
// 左右6列×3段（36キー）と右手最下段4キーは Cygnus と同じ割り当て。
// Cygnus にあって双掌にないキー（内側の追加列4キー、最下段左の3キー）の移し先:
//   LALT       → 左親指外側の長押し
//   Ctrl+Space → 左親指外側の単押し
//   矢印4キー  → ARROWレイヤー(3)。右親指内側(Backspace)の長押しで入る
//   中クリック → J + L のコンボ
//   内側の DELETE → 省略（最下段右の DEL と重複のため）
//スクロール量の調整(デフォルト150)

#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 4
#define SCROLL 5

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

//スクロールの調整

&msc {
    time-to-max-speed-ms = <0>;   // 即座に最大速度（加速なし）
    acceleration-exponent = <0>;   // 加速なし
};

// SCROLLレイヤー(5)の間は、ポインティングデバイスの動きをスクロールに変換する。
// （Cygnusではドライバの scroll-layers が担当している機能）
// スクロール方向が逆なら、各行の INPUT_TRANSFORM_Y_INVERT を付け外しする。
//右手トラックボール

&trackball_listener {
    scroller {
        layers = <SCROLL>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_X_INVERT>,
            <&zip_xy_to_scroll_mapper>;
    };
};

//右手トラックパッド

&glidepoint_listener {
    scroller {
        layers = <SCROLL>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
            <&zip_xy_to_scroll_mapper>;
    };
};

//左手トラックボール

&trackball_split_listener {
    scroller {
        layers = <SCROLL>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
            <&zip_xy_to_scroll_mapper>;
    };
};

//左手トラックパッド

&glidepoint_split_listener {
    scroller {
        layers = <SCROLL>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
            <&zip_xy_to_scroll_mapper>;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        //J + K

        left_click {
            bindings = <&mkp MB1>;
            key-positions = <19 20>;
            require-prior-idle-ms = <125>;
            layers = <0>;
            timeout-ms = <50>;
        };

        //K + L

        right_click {
            bindings = <&mkp MB2>;
            key-positions = <20 21>;
            require-prior-idle-ms = <125>;
            layers = <0>;
            timeout-ms = <50>;
        };

        //J + L（Cygnusの内側列にあった中クリックキーの代わり）

        middle_click {
            bindings = <&mkp MB3>;
            key-positions = <19 21>;
            require-prior-idle-ms = <125>;
            layers = <0>;
            timeout-ms = <50>;
        };
    };

    behaviors {
        //双掌のエンコーダ用（zmk_encoderモジュール）

        ec_ms_l: ec_ms_h {
            compatible = "zmk,behavior-encoder-mouse-scroll";
            #sensor-binding-cells = <2>;
        };

        ec_ms_r: ec_ms_v {
            compatible = "zmk,behavior-encoder-mouse-scroll";
            #sensor-binding-cells = <2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        //0

        default_layer {
            bindings = <
&lt 6 ESC  &kp Q     &kp W  &kp E  &kp R      &kp T         &kp Y            &kp U        &kp I      &kp O    &kp P           &kp BSPC
&kp TAB    &kp A     &kp S  &kp D  &kp F      &kp G         &kp H            &kp J        &kp K      &kp L    &lt 5 MINUS     &kp ENTER
&kp LSHFT  &kp Z     &kp X  &kp C  &kp V      &kp B         &kp N            &kp M        &kp COMMA  &kp DOT  &kp FSLH        &kp RSHFT
&kp LCTRL  &kp LGUI                &kp SPACE  &mt END HOME  &lt 3 BACKSPACE  &lt 2 ENTER                      &kp LANGUAGE_2  &kp LANGUAGE_1
            >;

            //左エンコーダ=縦スクロール（Cygnusと同じ）、右エンコーダ=横スクロール

            sensor-bindings = <&ec_ms_l SCRL_DOWN SCRL_UP &ec_ms_r SCRL_LEFT SCRL_RIGHT>;
        };

        //1

        function {
            bindings = <
&trans  &kp F1   &kp F2  &kp F3  &kp F4  &kp F5   &kp F1  &kp F2  &kp F3  &kp F4  &kp F5   &trans
&trans  &kp F6   &kp F7  &kp F8  &kp F9  &kp F10  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F13
&trans  &kp F11  &trans  &trans  &trans  &trans   &trans  &trans  &trans  &trans  &kp F11  &trans
&trans  &kp F12                  &trans  &trans   &trans  &trans                  &kp F12  &trans
            >;
        };

        //2

        num {
            bindings = <
&trans                   &kp MINUS                   &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp PLUS      &kp CARET         &kp AMPERSAND      &kp TILDE       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PRINTSCREEN
&kp LC(LA(KP_NUMBER_0))  &kp SLASH                   &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp ASTERISK  &kp EXCLAMATION   &kp AT_SIGN        &kp HASH        &kp DOLLAR            &kp PERCENT            &kp UNDERSCORE
&trans                   &mt LEFT_SHIFT KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp EQUAL     &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_BRACE  &kp RIGHT_BRACE       &kp BACKSLASH          &kp EQUAL
&trans                   &kp HOME                                                      &kp END          &trans        &trans            &trans                                                   &kp PIPE               &trans
            >;
        };

        //3

        arrow {
            bindings = <
&trans  &kp ESCAPE      &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &trans   &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans          &kp LG(LS(RIGHT_ARROW))  &trans   &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans                                                  &trans                   &trans   &trans  &trans                  &trans  &trans
            >;
        };

        //4

        mouse {
            bindings = <
&trans  &trans       &trans  &kp LC(PAGE_UP)  &kp LC(PAGE_DOWN)  &kp LC(R)  &kp LC(R)  &kp LC(PAGE_UP)  &kp LC(PAGE_DOWN)  &trans  &trans       &trans
&trans  &lt 5 SPACE  &trans  &mkp MB1         &mkp MB2           &mkp MB3   &mkp MB3   &mkp MB1         &mkp MB2           &trans  &lt 5 SPACE  &trans
&trans  &trans       &trans  &trans           &trans             &trans     &trans     &mkp MB4         &mkp MB5           &trans  &trans       &trans
&trans  &trans                                &trans             &trans     &trans     &trans                                      &trans       &trans
            >;
        };

        //5

        scroll {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans                  &trans  &trans  &trans  &trans                  &trans  &trans
            >;
        };

        //6

        layer_6 {
            bindings = <
&trans  &trans  &trans        &trans        &trans        &trans     &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans
&trans  &trans  &trans        &trans        &trans        &trans     &trans        &trans        &trans        &trans        &trans          &trans
&trans  &trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kt KP_N4  &trans        &trans        &trans        &trans        &bt BT_CLR      &trans
&trans  &trans                              &trans        &trans     &trans        &trans                                    &bt BT_CLR_ALL  &trans
            >;
        };
    };
};

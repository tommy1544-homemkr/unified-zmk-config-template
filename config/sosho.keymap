// 双掌 (SO-SHO) キーマップ — LiNEA40 のキーマップに合わせた構成
// 内側10列×3段と親指4キーは LiNEA40 と同じ割り当て。
// LiNEA40 最下段のうち双掌に置き場のない3キーは外側の列へ移動:
//   LEFT_WIN → A の左 / LEFT → Z の左 / RIGHT_BRACKET → 右中段の右端
// 双掌で増える外側3キー（デフォルト層のみ）: 左上 TAB / 右上 BACKSPACE / 右下 DEL

//スクロール量の調整(デフォルト150)
#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>

#define MOUSE 1
#define MARK 2
#define CURSOR 3
#define FUNCTION 4
#define SCROLL 5
#define WIRELESS 6

//スクロールの調整
&msc {
    time-to-max-speed-ms = <0>;   // 即座に最大速度（加速なし）
    acceleration-exponent = <0>;   // 加速なし
};

// SCROLLレイヤー(5)の間は、ポインティングデバイスの動きをスクロールに変換する。
// スクロール方向が逆なら、各行の INPUT_TRANSFORM_Y_INVERT を付け外しする。

//右手トラックボール
&trackball_listener {
    scroller {
        layers = <SCROLL>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_X_INVERT>,
            <&zip_xy_to_scroll_mapper>;
    };
};

//右手トラックパッド
&glidepoint_listener {
    scroller {
        layers = <SCROLL>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
            <&zip_xy_to_scroll_mapper>;
    };
};

//左手トラックボール
&trackball_split_listener {
    scroller {
        layers = <SCROLL>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
            <&zip_xy_to_scroll_mapper>;
    };
};

//左手トラックパッド
&glidepoint_split_listener {
    scroller {
        layers = <SCROLL>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
            <&zip_xy_to_scroll_mapper>;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        //S + D
        ZenkakuHankaku {
            bindings = <&kp GRAVE>;
            key-positions = <14 15>;
        };

        //I + O
        DeleteKey {
            bindings = <&kp DEL>;
            key-positions = <8 9>;
        };

        //U + I
        InsertKey {
            bindings = <&kp INS>;
            key-positions = <7 8>;
        };

        //J + K
        leftClick {
            bindings = <&mkp MB1>;
            key-positions = <20 19>;
        };

        //K + L
        RightClick {
            bindings = <&mkp MB2>;
            key-positions = <21 20>;
        };

        //J + L（双掌の元の設定を残したもの）
        MiddleClick {
            timeout-ms = <90>;
            bindings = <&mkp MB3>;
            key-positions = <19 21>;
        };

        //COMMA + DOT
        PrevClick {
            bindings = <&mkp MB4>;
            key-positions = <32 33>;
        };

        //M + COMMA
        ClickNext {
            bindings = <&mkp MB5>;
            key-positions = <31 32>;
        };
    };

    behaviors {
        //双掌のエンコーダ用（zmk_encoderモジュール）。左=横スクロール、右=縦スクロール
        ec_ms_l: ec_ms_h {
            compatible = "zmk,behavior-encoder-mouse-scroll";
            #sensor-binding-cells = <2>;
        };

        ec_ms_r: ec_ms_v {
            compatible = "zmk,behavior-encoder-mouse-scroll";
            #sensor-binding-cells = <2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        //0

        default_layer {
            bindings = <
&kp TAB        &kp Q               &kp W  &kp E  &kp R        &kp T          &kp Y            &kp U        &kp I      &kp O    &kp P                      &kp BACKSPACE
&kp LEFT_WIN   &kp A               &kp S  &kp D  &kp F        &kp G          &kp H            &lt 3 J      &kp K      &kp L    &lt 5 MINUS                &kp RIGHT_BRACKET
&kp LEFT       &mt LEFT_SHIFT Z    &kp X  &kp C  &kp V        &lt 6 B        &kp N            &lt 4 M      &kp COMMA  &kp DOT  &mt RIGHT_SHIFT BACKSPACE  &kp DEL
&mt LCTRL ESC  &mt LEFT_ALT GRAVE                &lt 5 SPACE  &lt 2 RIGHT    &lt 7 BACKSPACE  &lt 8 ENTER                      &mt LANGUAGE_2 BACKSLASH   &mt LANGUAGE_1 SLASH
            >;

            sensor-bindings = <&ec_ms_l SCRL_LEFT SCRL_RIGHT &ec_ms_r SCRL_DOWN SCRL_UP>;
        };

        //1

        mouse {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans    &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &mkp MB1  &mkp MB2  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans    &trans    &trans  &trans  &trans
&trans  &trans                  &trans  &trans    &trans  &trans                      &trans  &trans
            >;
        };

        //2

        mark {
            bindings = <
&trans  &kp EXCLAMATION             &kp AT           &kp HASH         &kp DOLLAR     &kp PERCENT      &kp CARET     &kp AMPERSAND  &kp ASTERISK           &kp LEFT_PARENTHESIS  &kp LBKT              &trans
&trans  &kp SLASH                   &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp SEMICOLON  &kp SEMICOLON    &kp C_MUTE    &kp LS(LBKT)   &kp RIGHT_BRACKET      &kp BACKSLASH         &kp EQUAL             &kp ASTERISK
&trans  &mt LEFT_SHIFT KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp APOS       &kp SQT          &kp KP_EQUAL  &kp INT3       &kp LS(RIGHT_BRACKET)  &kp LS(BACKSLASH)     &kp LS(INT1)          &trans
&trans  &trans                                                        &trans         &trans           &trans        &trans                                                      &kp LEFT_PARENTHESIS  &kp LS(QUESTION)
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP &ec_ms_r SCRL_DOWN SCRL_UP>;
        };

        //3

        cursor {
            bindings = <
&trans  &trans    &kp LC(LG(LEFT_ARROW))  &kp UP_ARROW  &kp LC(LG(RIGHT_ARROW))  &trans    &kp KP_MULTIPLY  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp KP_PLUS   &trans
&trans  &trans    &mt HOME LEFT_ARROW     &kp DOWN      &mt END RIGHT_ARROW      &trans    &kp KP_SLASH     &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp KP_MINUS  &kp DOT
&trans  &kp HOME  &kp PAGE_DOWN           &kp END       &kp PAGE_UP              &trans    &kp UNDER        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp ENTER     &trans
&trans  &trans                                          &trans                   &trans    &kp ENTER        &kp NUMBER_0                              &kp ENTER     &kp QUESTION
            >;
        };

        //4

        function {
            bindings = <
&trans  &kp F1  &kp F2  &kp F3  &kp F4   &kp F5     &trans      &trans  &kp LA(PRINTSCREEN)  &trans  &kp LC(LA(DELETE))  &trans
&trans  &kp F6  &kp F7  &kp F8  &kp F9   &kp F10    &trans      &trans  &kp LS(LG(S))        &trans  &kp LC(LS(ESCAPE))  &trans
&trans  &trans  &trans  &trans  &kp F11  &kp F12    &kp C_MUTE  &trans  &trans               &trans  &kp LC(LA(INS))     &trans
&trans  &trans                  &trans   &trans     &trans      &trans                               &trans              &trans
            >;
        };

        //5

        scroll {
            bindings = <
&trans  &trans    &kp LC(LG(LEFT_ARROW))  &kp UP_ARROW  &kp LC(LG(RIGHT_ARROW))  &trans    &kp KP_MULTIPLY  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp KP_PLUS   &trans
&trans  &trans    &kp LEFT_ARROW          &kp DOWN      &kp RIGHT_ARROW          &trans    &kp KP_SLASH     &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp KP_MINUS  &kp NUMBER_0
&trans  &kp HOME  &kp PAGE_DOWN           &kp END       &kp PAGE_UP              &trans    &kp UNDER        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp ENTER     &trans
&trans  &trans                                          &trans                   &trans    &trans           &kp NUMBER_0                              &kp DOT       &kp QUESTION
            >;

            sensor-bindings = <&ec_ms_l SCRL_LEFT SCRL_RIGHT &inc_dec_kp DOWN_ARROW UP_ARROW>;
        };

        //6

        wireless {
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans
&trans  &trans        &trans        &trans        &trans        &trans          &trans        &trans          &trans        &trans        &trans        &trans
&trans  &trans        &trans        &trans        &trans        &trans          &trans        &trans          &trans        &trans        &bt BT_CLR    &trans
&trans  &trans                                    &trans        &trans          &bootloader   &studio_unlock                              &trans        &bt BT_CLR_ALL
            >;

            sensor-bindings = <&ec_ms_l SCRL_LEFT SCRL_RIGHT &inc_dec_kp RIGHT_ARROW LEFT_ARROW>;
        };

        //7

        layer_7 {
            bindings = <
&trans  &kp ESC         &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp TAB         &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp LEFT_SHIFT  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans                          &trans  &trans    &trans  &trans                  &trans  &trans
            >;
        };

        //8

        number {
            bindings = <
&trans    &mt KP_NUMLOCK MINUS  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp PLUS        &kp CARET  &kp AMPERSAND     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PRINTSCREEN  &trans
&trans    &kp SLASH             &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp ASTERISK    &kp EXCL   &kp AT            &kp HASH              &kp PERCENT            &trans           &trans
&kp HOME  &kp LEFT_SHIFT        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp KP_EQUAL    &kp UNDER  &kp LEFT_BRACKET  &kp RIGHT_BRACKET     &trans                 &trans           &trans
&trans    &trans                                            &trans        &kp END         &trans     &trans                                                         &trans           &trans
            >;
        };
    };
};
